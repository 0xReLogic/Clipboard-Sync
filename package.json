{
  "name": "clipboard-sync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run build && npm run deploy --workspace=apps/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "node test-integration.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.11.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
